# Olli CMS - Apache asetukset
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Estä suora pääsy JSON-tietotiedostoihin
    RewriteRule ^content/(config|pages|posts|messages)/.*\.json$ - [F,L]
</IfModule>

<FilesMatch "\.(json|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
